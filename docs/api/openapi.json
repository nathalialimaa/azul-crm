        "title": "CustomerPage"
      },
      "CustomerResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "home_airport": {
            "type": "string",
            "title": "Home Airport"
          },
          "preferred_channel": {
            "type": "string",
            "title": "Preferred Channel"
          },
          "loyalty_tier": {
            "type": "string",
            "title": "Loyalty Tier"
          },
          "is_synthetic": {
            "type": "boolean",
            "title": "Is Synthetic"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id",
          "home_airport",
          "preferred_channel",
          "loyalty_tier",
          "is_synthetic"
        ],
        "title": "CustomerResponse"
      },
      "Decision": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "status": {
            "type": "string",
            "pattern": "^(APPROVED|REJECTED)$",
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          },
          "confirmed_checklist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Confirmed Checklist"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "status"
        ],
        "title": "Decision"
      },
      "DetailResponse": {
        "properties": {
          "customer": {
            "$ref": "#/components/schemas/CustomerResponse"
          },
          "trips": {
            "items": {
              "$ref": "#/components/schemas/TripResponse"
            },
            "type": "array",
            "title": "Trips"
          },
          "scores": {
            "$ref": "#/components/schemas/ScoresResponse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer",
          "trips",
          "scores"
        ],
        "title": "DetailResponse"
      },
      "EvidenceResponse": {
        "properties": {
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "is_demo": {
            "type": "boolean",
            "title": "Is Demo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "document_id",
          "title",
          "text",
          "source",
          "version",
          "is_demo"
        ],
        "title": "EvidenceResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Question": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Question"
          },
          "customer_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customer Id"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "Question"
      },
      "RecommendationRequest": {
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Customer Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "action": {
            "$ref": "#/components/schemas/ActionResponse"
          },
          "draft": {
            "type": "string",
            "title": "Draft"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceResponse"
            },
            "type": "array",
            "title": "Evidence"
          },
          "status": {
            "type": "string",
            "const": "DRAFT_REQUIRES_REVIEW",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "const": "demo_template",
            "title": "Mode"
          },
          "review_checklist": {
            "items": {
              "$ref": "#/components/schemas/ChecklistItemResponse"
            },
            "type": "array",
            "title": "Review Checklist"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id",
          "action",
          "draft",
          "evidence",
          "status",
          "mode"
        ],
        "title": "RecommendationResponse"
      },
      "ScoresResponse": {
        "properties": {
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "value_score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Value Score"
          },
          "churn_risk": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Churn Risk"
          },
          "priority_score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Priority Score"
          },
          "estimated_value_at_risk": {
            "type": "number",
            "minimum": 0.0,
            "title": "Estimated Value At Risk"
          },
          "segment": {
            "type": "string",
            "title": "Segment"
          },
          "drivers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Drivers"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date",
            "title": "Evaluated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id",
          "value_score",
          "churn_risk",
          "priority_score",
          "estimated_value_at_risk",
          "segment",
          "drivers",
          "model_version",
          "evaluated_at"
        ],
        "title": "ScoresResponse"
      },
      "SimulationRequest": {
        "properties": {
          "cost_per_customer": {
            "type": "number",
            "maximum": 100000.0,
            "minimum": 0.0,
            "title": "Cost Per Customer",
            "default": 10
          },
          "assumed_retention": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Assumed Retention",
            "default": 0.1
          },
          "months": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Months",
            "default": 12
          },
          "segment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segment"
          },
          "route": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          }
        },
        "type": "object",
        "title": "SimulationRequest"
      },
      "TripResponse": {
        "properties": {
          "trip_id": {
            "type": "string",
            "title": "Trip Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "destination": {
            "type": "string",
            "title": "Destination"
          },
          "flight_date": {
            "type": "string",
            "format": "date",
            "title": "Flight Date"
          },
          "fare_amount": {
            "type": "number",
            "minimum": 0.0,
            "title": "Fare Amount"
          },
          "delay_minutes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Delay Minutes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "trip_id",
          "customer_id",
          "origin",
          "destination",
          "flight_date",
          "fare_amount",
          "delay_minutes"
