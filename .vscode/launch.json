{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Azul CRM · Web",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "web.api.index:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8504"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Azul CRM · Apresentação",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "streamlit_app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8502"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
